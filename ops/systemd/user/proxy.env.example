# Copy to ~/.config/sensei/proxy.env and restrict it to the local user (0600).
# Every setting maps directly to a cnc-proxy flag: CNC_FOO_BAR -> -foo-bar.
CNC_ALLOW_INSECURE_HTTP=true
CNC_MACHINE=192.168.1.43:2222
CNC_ADVERTISE=true
CNC_NAME=Makera_Z1_011855 (proxy)
CNC_TCP_PORT=2222
CNC_API_ADDR=0.0.0.0:8420
CNC_API_ALLOWED_HOSTS=example.tailnet.ts.net
CNC_DAV_ADDR=127.0.0.1:8421
CNC_DATA_DIR=/home/USER/.local/share/sensei
CNC_NOTIFY_NTFY_URL=https://ntfy.sh/REPLACE_ME
CNC_NOTIFY_DASHBOARD_URL=https://example.tailnet.ts.net/dashboard
CNC_CAMERA_EXTERNAL_URL=http://127.0.0.1:8081/stream
CNC_CAMERA_EXTERNAL_MODE=mjpeg
